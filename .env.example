# ================================================================
# LLM Provider Configuration
# Choose your preferred provider: 'openai', 'openrouter', or 'gemini'
# ================================================================
LLM_PROVIDER=openai

# Execution Process Mode: 'sequential' (default) or 'hierarchical'
CREW_PROCESS=sequential

# ----------------------------------------------------------------
# Option 1: OpenAI Configuration (Standard or Custom Base URL)
# ----------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
MODEL=gpt-4o-mini

# Optional: Custom OpenAI Base URL (for Ollama, vLLM, DeepSeek, Proxies)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_BASE_URL=http://localhost:11434/v1

# ----------------------------------------------------------------
# Option 2: OpenRouter AI Configuration
# ----------------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
# MODEL=openrouter/google/gemini-2.5-flash
# MODEL=openrouter/anthropic/claude-3.5-sonnet
# MODEL=openrouter/deepseek/deepseek-chat

# ----------------------------------------------------------------
# Option 3: Google Gemini Configuration
# ----------------------------------------------------------------
# GEMINI_API_KEY=your_gemini_api_key_here
# MODEL=gemini/gemini-2.5-flash

# ----------------------------------------------------------------
# Runtime Tuning (Optional)
# ----------------------------------------------------------------
# REQUEST_TIMEOUT=180
# MAX_TOKENS=8192
# MAX_RPM=25

# ----------------------------------------------------------------
# Agent Iteration Limits (Optional)
# Maximum tool execution loops allowed before requesting final answer
# ----------------------------------------------------------------
# MAX_ITER=30            # Global default for all agents
MAX_ITER_BA=20          # Dedicated limit for Business Analyst & Architect
MAX_ITER_BACKEND=35     # Dedicated limit for Backend Coding Engineer
MAX_ITER_FRONTEND=35    # Dedicated limit for Frontend Coding Engineer
MAX_ITER_QA=25          # Dedicated limit for QA Verification Engineer
